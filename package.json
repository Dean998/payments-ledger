{
  "name": "payments-ledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Double-entry ledger and ACH-style payments service: idempotent APIs, transactional outbox, signed webhooks and continuous reconciliation.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json && cp -R src/db/migrations dist/db/",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "migrate": "tsx src/db/migrate.ts",
    "demo": "tsx scripts/demo.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "load": "docker run --rm -i -e BASE_URL=http://host.docker.internal:3000 grafana/k6 run - < load/transfers.k6.js"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.4",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^10.15.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  },
  "allowScripts": {
    "esbuild": false
  }
}
